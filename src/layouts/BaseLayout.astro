---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'XIII Coloquio Internacional de Lenguaje y Cultura',
  description = 'Sitio oficial del XIII Coloquio Internacional de Lenguaje y Cultura.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <title>XIII Coloquio Internacional de Lenguaje y Cultura</title>

<meta
  name="description"
  content="Sitio oficial del XIII Coloquio Internacional de Lenguaje y Cultura: Pedagogías críticas, voces desde la interculturalidad. Evento académico internacional organizado en Colombia."
/>

<link rel="canonical" href="https://coloquiolenguajeycultura.org/" />

<meta property="og:title" content="XIII Coloquio Internacional de Lenguaje y Cultura" />
<meta
  property="og:description"
  content="Pedagogías críticas: voces desde la interculturalidad. Evento académico internacional sobre lenguaje, cultura, literatura, pedagogía crítica e interculturalidad."
/>
<meta property="og:type" content="website" />
<meta property="og:url" content="https://coloquiolenguajeycultura.org/" />
<meta property="og:image" content="https://coloquiolenguajeycultura.org/images/fondo-hero.png" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="XIII Coloquio Internacional de Lenguaje y Cultura" />
<meta
  name="twitter:description"
  content="Evento académico internacional sobre lenguaje, cultura, literatura, pedagogía crítica e interculturalidad."
/>
<meta name="twitter:image" content="https://coloquiolenguajeycultura.org/images/fondo-hero.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
