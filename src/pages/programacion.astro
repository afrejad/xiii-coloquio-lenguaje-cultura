        {title:'Habitar entre lenguas: experiencias narradas por estudiantes indígenas universitarios del Cauca',people:'Maribel Rojas Fernández · UPTC'},
        {title:'Corporalidades campesinas y prácticas artísticas',people:'Luis Yecid Bayona · UPTC'},
        {title:'Sentidos de la experiencia docente en el modelo educativo propio Shama Zhigui',people:'Gabriel Ángel Galiano Rangel · UPTC'},
