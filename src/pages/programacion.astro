---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Talk = { title: string; people: string };
type Event = { id: string; time: string; room: string; kind: string; title: string; people?: string; duration?: string; talks?: Talk[]; note?: string };
type Day = { id: string; short: string; date: string; events: Event[] };

const days: Day[] = [
