---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import program from '../data/programacion.json';

const { days, exhibition } = program;
const institutions = [
  { src: 'uptc.svg', title: 'Universidad Pedagógica y Tecnológica de Colombia', role: 'Organiza' },
  { src: 'doctorado.svg', title: 'Doctorado en Lenguaje y Cultura', role: 'Organiza' },
  { src: 'ML.png', title: 'Maestría en Lingüística', role: 'Organiza' },
  { src: 'facultad.png', title: 'Facultad de Ciencias de la Educación · UPTC', role: 'Acompañamiento y apoyo' },
  { src: 'banco-republica.png', title: 'Banco de la República', role: 'Acompañamiento y apoyo' },
];
---

<BaseLayout title="Programación | XIII Coloquio Internacional en Lenguaje y Cultura" description="Programa completo del XIII Coloquio: conferencias, 15 mesas temáticas, talleres, teatro, exposición y concierto. 21, 22 y 23 de octubre de 2026, UPTC, Tunja.">
  <Header />
  <main id="inicio" class="schedule-page">
    <section class="program-cover" aria-labelledby="program-title">
      <div class="container cover-grid">
        <div class="cover-copy">
          <img class="cover-university" src="/images/programacion/uptc-acreditacion.png" alt="UPTC · Acreditación institucional de alta calidad multicampus" width="200" height="62" />
          <div class="cover-identity" aria-label="XIII Coloquio Internacional en Lenguaje y Cultura">
            <span class="cover-edition" aria-hidden="true">XIII</span>
            <span class="cover-name" aria-hidden="true">Coloquio<br />Internacional<br />en Lenguaje<br />y Cultura</span>
          </div>
          <h1 id="program-title">Programación</h1>
          <p class="cover-theme">Pedagogías críticas <span>Voces desde la interculturalidad</span></p>
          <p class="cover-date">21 / 22 / 23 <span>octubre · 2026</span></p>
          <p class="cover-location">UPTC · Sede central · Tunja, Colombia</p>
          <div class="cover-actions">
            <a class="program-button" href="#agenda">Consultar la agenda <span aria-hidden="true">↓</span></a>
            <a class="program-link" href={program.canvaViewUrl} target="_blank" rel="noopener noreferrer">Ver guía ilustrada en Canva <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <img class="cover-art" src="/images/programacion/collage.webp" width="620" height="734" alt="Collage del Coloquio: voces, territorios, lectura y saberes compartidos" fetchpriority="high" />
      </div>
    </section>

    <section class="container program-welcome" aria-labelledby="welcome-title">
      <div><span class="eyebrow-text">Presentación</span><h2 id="welcome-title">Voces que se encuentran,<br /><em>saberes que dialogan</em></h2></div>
      <div class="welcome-text">{program.intro.map(text => <p>{text}</p>)}</div>
    </section>

    <nav class="program-nav" aria-label="Recorrer la programación">
      <div class="container program-nav-inner">
        {days.map(day => <a href={`#${day.id}`} class="day-tab" style={`--day-color:${day.accent}`}><span>{day.weekday}</span><strong>{day.day}</strong></a>)}
        <a href="#exposicion-fotografica" class="extra-tab">Exposición</a>
        <a href="#agradecimientos" class="extra-tab">Instituciones</a>
      </div>
    </nav>

    <div id="agenda" class="container schedule-content">
      <div class="reading-guide">
        <p>Elige el día y sigue las horas de inicio. Las actividades simultáneas comparten franja.<br /><span>Horarios en formato de 24 horas. Despliega cada mesa para consultar sus ponencias.</span></p>
        <button id="toggle-talks" class="text-button" type="button" aria-expanded="false" hidden>Desplegar todas las ponencias <span aria-hidden="true">+</span></button>
      </div>
      {days.map(day => (
        <section id={day.id} class="schedule-day" style={`--day-color:${day.accent}`} aria-labelledby={`title-${day.id}`}>
          <header class="day-heading">
            <span class="day-number" aria-hidden="true">{day.day}</span>
            <div><h2 id={`title-${day.id}`}>{day.weekday} <span class="sr-only">{day.day}</span></h2><p>Octubre de 2026</p></div>
            
          </header>
          <div class="day-timeline">
            {day.groups.map(group => (
              <div class="time-group">
                <div class="time-rail"><time datetime={`2026-10-${day.day}T${group.start}:00-05:00`}>{group.start}</time>{group.events.filter(event => event.type !== 'logistics').length > 1 && <span>En simultáneo</span>}</div>
                <div class:list={['time-events', group.events.filter(event => event.type !== 'logistics').length > 1 && 'parallel-events']}>
                  {group.events.map(event => event.type === 'logistics' ? (
                    <article id={event.id} class="logistics-entry"><time>{event.time}</time><div><strong>{event.title}</strong><span>{event.rooms.join(' y ')}</span></div></article>
                  ) : (
                    <article id={event.id} class:list={['event-card', event.type === 'mesa' && 'has-talks']}>
                      <div class="event-meta"><time>{event.time}</time><span>{event.rooms.join(' y ')}</span></div>
                      <p class="event-kind">{event.kind}</p>
                      {'portraits' in event && event.portraits && <div class:list={['portrait-row', event.portraits.length > 1 && 'portrait-group']}>{event.portraits.map(portrait => <img src={portrait.src} alt={`Retrato de ${portrait.name}`} width="100" height="116" loading="lazy" />)}</div>}
                      <h3><a href={`#${event.id}`}>{event.title}</a></h3>
                      {'people' in event && event.people && <p class="event-people">{event.people}</p>}
                      {'note' in event && event.note && <p class="event-note">{event.note}</p>}
                      {'talks' in event && event.talks && (
                        <details class="talk-details">
                          <summary>Ver {event.talks.length} {event.id === 'mesa-2' ? 'intervenciones' : 'ponencias'}<span class="detail-symbol" aria-hidden="true"></span></summary>
                          <ol>{event.talks.map(talk => <li><h4>{talk.title}</h4><p class="talk-author">{talk.author}</p>{talk.affiliation && <p class="talk-affiliation">{talk.affiliation}</p>}</li>)}</ol>
                        </details>
                      )}
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <a class="day-back" href="#agenda">Volver a los días <span aria-hidden="true">↑</span></a>
        </section>
      ))}

      <section id={exhibition.id} class="exhibition" aria-labelledby="exhibition-title">
        <div class="exhibition-copy">
          <p class="eyebrow-text">Durante el Coloquio · 21–23 de octubre</p>
          <p class="exhibition-time">{exhibition.time}</p>
          <h2 id="exhibition-title">Exposición<br /><em>fotográfica</em></h2>
          <h3>{exhibition.title}</h3>
          <p class="exhibition-author">{exhibition.people}</p>
          <p>{exhibition.place}<br />{exhibition.address}</p>
        </div>
        <div class="exhibition-visual"><img src="/images/invitados/invitado-5.jpg" alt="Fernando Urbina Rangel, autor de la exposición" width="520" height="430" loading="lazy" /></div>
      </section>

      <section id="agradecimientos" class="program-thanks" aria-labelledby="thanks-title">
        <p class="eyebrow-text">Hacer posible el encuentro</p>
        <h2 id="thanks-title">Gracias por tejer <em>este diálogo</em></h2>
        <p class="thanks-intro">{program.thanks}</p>
        <div class="institutions">{institutions.map(institution => <figure><span>{institution.role}</span><div><img src={`/images/logos/${institution.src}`} alt="" loading="lazy" /></div><figcaption>{institution.title}</figcaption></figure>)}</div>
      </section>
      <div class="program-end"><p>Pedagogías críticas:<br /><strong>voces desde la interculturalidad</strong></p><a href={program.canvaViewUrl} target="_blank" rel="noopener noreferrer">Consultar la guía ilustrada <span aria-hidden="true">↗</span></a></div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  const allTalks = [...document.querySelectorAll<HTMLDetailsElement>('.talk-details')];
  const toggle = document.querySelector<HTMLButtonElement>('#toggle-talks');
  function syncToggle() {
    const expanded = allTalks.length > 0 && allTalks.every(detail => detail.open);
    if (toggle) {
      toggle.setAttribute('aria-expanded', String(expanded));
      toggle.textContent = expanded ? 'Plegar todas las ponencias −' : 'Desplegar todas las ponencias +';
    }
  }
  if (toggle) {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const open = !allTalks.every(detail => detail.open);
      allTalks.forEach(detail => { detail.open = open; });
      syncToggle();
    });
    allTalks.forEach(detail => detail.addEventListener('toggle', syncToggle));
  }
  function revealLinkedActivity() {
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    if (!id) return;
    const activity = document.getElementById(id);
    const detail = activity?.querySelector<HTMLDetailsElement>('.talk-details');
    if (detail) {
      detail.open = true;
      syncToggle();
      requestAnimationFrame(() => activity?.scrollIntoView({ block: 'start', behavior: 'instant' }));
    }
  }
  revealLinkedActivity();
  window.addEventListener('hashchange', revealLinkedActivity);
  const header = document.querySelector('.site-header');
  if (header) {
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--site-header-height', `${header.getBoundingClientRect().height}px`);
    }).observe(header);
  }
  const tabs = document.querySelectorAll<HTMLAnchorElement>('.day-tab');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      tabs.forEach(tab => {
        if (tab.hash === `#${entry.target.id}`) tab.setAttribute('aria-current', 'date');
        else tab.removeAttribute('aria-current');
      });
    });
  }, { rootMargin: '-22% 0px -64% 0px' });
  document.querySelectorAll('.schedule-day').forEach(day => observer.observe(day));
</script>

<style>
  @font-face{font-family:'Barlow Condensed';src:url('/fonts/barlow-condensed-semibold.ttf') format('truetype');font-weight:600;font-style:normal;font-display:swap}
  .schedule-page{--paper:#faf3e5;--ink:#183b2c;--clay:#892412;--plum:#653050;--rule:#cbbfa9;background-color:var(--paper);background-image:linear-gradient(#faf3e5a8,#faf3e5a8),url('/images/programacion/papel.webp');background-size:auto,540px 800px;color:var(--ink);font-family:Inter,Arial,sans-serif;line-height:1.6}
  .schedule-page :is(h1,h2,h3,h4,p){margin-top:0}.schedule-page :is(a,button,summary):focus-visible{outline:3px solid #d3931c;outline-offset:5px}.schedule-page :is(section,article,#agenda){scroll-margin-top:calc(var(--site-header-height,82px) + 94px)}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .program-cover{border-top:8px solid var(--clay);border-bottom:1px solid var(--rule);overflow:hidden}.cover-grid{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:2.5rem;padding:3rem 0 2.5rem}.cover-university{margin-bottom:1.9rem;width:200px;height:auto}.cover-identity{display:flex;gap:1.1rem;align-items:center;padding-bottom:1rem;border-bottom:1px solid var(--clay);max-width:32rem}.cover-edition{font:600 clamp(5.4rem,9vw,8.8rem)/.9 'Barlow Condensed',sans-serif;color:var(--clay)}.cover-name{border-left:2px solid var(--ink);padding-left:1.1rem;font:600 clamp(1.15rem,2vw,1.65rem)/1 'Barlow Condensed',sans-serif;text-transform:uppercase}.cover-copy h1{font:600 clamp(3.2rem,6.4vw,5.8rem)/1.03 'Barlow Condensed',sans-serif;text-transform:uppercase;margin:1.35rem 0 1.2rem;letter-spacing:-.015em}.cover-theme{font:600 clamp(1.7rem,2.4vw,2.3rem)/1.12 'Barlow Condensed',sans-serif;color:var(--plum);text-transform:uppercase}.cover-theme span{display:block;font-size:.76em;color:var(--ink);margin-top:.45rem}.cover-date{font:600 clamp(2.5rem,4vw,3.8rem)/1.1 'Barlow Condensed',sans-serif;margin:1.5rem 0 .45rem}.cover-date span{display:inline-block;font-size:.45em;margin-left:.8rem;text-transform:uppercase}.cover-location{font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;font-weight:600}.cover-art{width:100%;height:auto;max-height:650px;object-fit:contain;align-self:end}.cover-actions{display:flex;align-items:center;flex-wrap:wrap;gap:1rem 1.4rem;margin-top:1.65rem}.program-button{display:inline-flex;gap:1.7rem;align-items:center;padding:.75rem 1.1rem;background:var(--ink);color:var(--paper);font-size:.91rem;font-weight:600}.program-button:hover{background:var(--clay)}.program-link{font-size:.82rem;text-decoration:underline;text-underline-offset:4px;font-weight:600}.program-link span{margin-left:.3rem}
  .program-welcome{display:grid;grid-template-columns:1fr 1.2fr;gap:3rem;padding:3.8rem 0}.eyebrow-text{display:block;font:600 .91rem/1.2 'Barlow Condensed',sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--clay);margin-bottom:.85rem}.program-welcome h2,.program-thanks h2{font:600 clamp(2rem,3.2vw,3rem)/1.04 'Cormorant Garamond',Georgia,serif;margin:0}.program-welcome h2 em,.program-thanks h2 em{font-style:normal;color:var(--plum)}.welcome-text p{margin-bottom:.95rem;font-size:.96rem}.welcome-text p:last-child{font-size:.88rem;font-weight:600;margin-bottom:0}
  .program-nav{position:sticky;top:var(--site-header-height,82px);z-index:20;background:#faf3e5f5;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);backdrop-filter:blur(10px)}.program-nav-inner{display:flex;align-items:stretch;gap:1.3rem}.day-tab{display:flex;align-items:center;gap:.65rem;color:var(--day-color);padding:.6rem .65rem;border-bottom:3px solid transparent;font-family:'Barlow Condensed',sans-serif}.day-tab span{font-size:.94rem;text-transform:uppercase}.day-tab strong{font-size:1.85rem;font-weight:600;line-height:1}.day-tab:hover,.day-tab[aria-current]{border-bottom-color:var(--day-color);background:#eaca8e3b}.extra-tab{display:flex;align-items:center;font-size:.82rem;font-weight:600}.extra-tab:first-of-type{margin-left:auto}.extra-tab:hover{text-decoration:underline;text-underline-offset:5px}
  .schedule-content{padding-top:2.5rem}.reading-guide{display:flex;align-items:center;justify-content:space-between;gap:2rem;margin-bottom:2.5rem}.reading-guide p{font-size:.88rem;margin-bottom:0}.reading-guide p span{color:#5f5a54;font-size:.83rem}.text-button{background:none;border:0;border-bottom:1px solid var(--clay);padding:.4rem 0;color:var(--clay);font-family:inherit;font-size:.84rem;font-weight:600;cursor:pointer;text-align:left;flex-shrink:0}.text-button[hidden]{display:none}
  .schedule-day{margin-bottom:4.8rem}.day-heading{background:var(--day-color);color:var(--paper);display:flex;align-items:center;gap:1.45rem;padding:1.15rem 1.8rem;border-bottom:5px solid #d3931c;position:relative;overflow:hidden}.day-number{font:600 6.2rem/.95 'Barlow Condensed',sans-serif}.day-heading h2{font:600 2rem/1.1 'Barlow Condensed',sans-serif;text-transform:uppercase;margin-bottom:.2rem}.day-heading p{margin:0;text-transform:uppercase;font-size:.79rem;letter-spacing:.1em}.day-heading>img{position:absolute;right:1.25rem;width:140px;height:140px;opacity:.8;filter:brightness(1.2)}.day-timeline{margin-top:1.4rem}.time-group{display:grid;grid-template-columns:95px minmax(0,1fr);gap:1.3rem;margin-bottom:1.1rem}.time-rail{position:relative;border-right:1px solid var(--rule);padding-top:.9rem;padding-right:.65rem;color:var(--day-color)}.time-rail time{display:block;font:600 1.9rem/1.1 'Barlow Condensed',sans-serif}.time-rail>span{display:block;font-size:.65rem;font-weight:600;text-transform:uppercase;line-height:1.25;margin-top:.55rem;max-width:75px}.time-events{display:grid;grid-template-columns:minmax(0,1fr);gap:1rem;align-items:start}.parallel-events{grid-template-columns:repeat(2,minmax(0,1fr))}.event-card{background:#fffaf2cf;border:1px solid #cbbfa98c;border-top:3px solid var(--day-color);padding:1.3rem 1.5rem;min-width:0}.event-card:target{outline:3px solid #d3931c;outline-offset:3px}.event-meta{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:.3rem .8rem;color:var(--day-color)}.event-meta time{font:600 1.32rem/1.1 'Barlow Condensed',sans-serif}.event-meta>span{font-size:.78rem;font-weight:600}.event-kind{font:600 .87rem/1.15 'Barlow Condensed',sans-serif;text-transform:uppercase;letter-spacing:.04em;color:var(--day-color);margin:1rem 0 .65rem!important}.event-card h3{font:600 clamp(1.65rem,2.4vw,2.15rem)/1.09 'Cormorant Garamond',Georgia,serif;color:var(--day-color);margin-bottom:.8rem}.event-card h3 a:hover{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}.event-people{font-size:.93rem;line-height:1.45;font-weight:600;margin-bottom:.35rem}.event-note{font-size:.83rem;line-height:1.5;color:#625d51;margin-bottom:.2rem}.portrait-row{float:right;display:flex;gap:.35rem;margin:0 0 .6rem 1rem}.portrait-row img{width:92px;height:110px;object-fit:cover;object-position:center 25%}.portrait-group{float:none;margin:0 0 .9rem;gap:.6rem}.portrait-group img{width:70px;height:78px}.event-card:after{content:'';display:table;clear:both}
  .logistics-entry{grid-column:1/-1;display:flex;gap:1.4rem;align-items:center;background:#e9e1cfb8;padding:.6rem 1rem;font-size:.8rem;min-width:0}.logistics-entry>time{font:600 1.1rem/1.2 'Barlow Condensed',sans-serif;white-space:nowrap;color:var(--day-color)}.logistics-entry strong{font-weight:600}.logistics-entry span{margin-left:.65rem;color:#625d51}.talk-details{clear:both;margin-top:1rem;border-top:1px solid var(--rule)}.talk-details summary{cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:.7rem;list-style:none;padding:.85rem 0 .1rem;font-size:.86rem;font-weight:600;color:var(--day-color)}.talk-details summary::-webkit-details-marker{display:none}.detail-symbol:after{content:'+';font-size:1.1rem}.talk-details[open] .detail-symbol:after{content:'−'}.talk-details ol{counter-reset:talk;list-style:none;padding:0;margin:1rem 0 0}.talk-details li{position:relative;counter-increment:talk;padding:1.05rem 0 1.05rem 2.1rem;border-top:1px solid #cbbfa966}.talk-details li:before{content:counter(talk,decimal-leading-zero);position:absolute;left:0;top:1.06rem;font:600 1rem/1.3 'Barlow Condensed',sans-serif;color:var(--day-color)}.talk-details li h4{font:600 1rem/1.45 Inter,Arial,sans-serif;margin-bottom:.35rem;color:#161e15}.talk-author{font-size:.9rem;line-height:1.5;margin-bottom:.1rem}.talk-affiliation{font-size:.81rem;line-height:1.45;color:#625d51;margin-bottom:0}.talk-details li:last-child{padding-bottom:0}.day-back{display:block;text-align:right;font-size:.79rem;font-weight:600;color:var(--day-color);margin-top:1.2rem}.day-back:hover{text-decoration:underline}
  .exhibition{display:grid;grid-template-columns:1.15fr 1fr;gap:3rem;background:var(--ink);color:var(--paper);padding:clamp(1.5rem,4vw,3.5rem);margin:0 0 4rem}.exhibition .eyebrow-text{color:#eaca8e}.exhibition-time{font:600 1.8rem/1.1 'Barlow Condensed',sans-serif;margin-bottom:1.4rem}.exhibition h2{font:600 clamp(2.7rem,4.3vw,4.2rem)/.95 'Cormorant Garamond',Georgia,serif;margin-bottom:1.7rem}.exhibition h2 em{font-style:normal;color:#eaca8e}.exhibition h3{font:600 clamp(1.45rem,2.4vw,2rem)/1.14 'Cormorant Garamond',Georgia,serif;margin-bottom:1rem}.exhibition-author{font-weight:600}.exhibition-copy>p:last-child{font-size:.9rem;margin-bottom:0}.exhibition-visual{position:relative;align-self:center;padding-bottom:2rem}.exhibition-visual>img:first-child{width:100%;height:auto;aspect-ratio:1.1;object-fit:cover;object-position:60% center}.exhibition-motif{position:absolute;right:-1.5rem;bottom:-2rem;background:var(--paper);border-radius:50%;width:150px;height:150px;padding:.3rem}
