      { id:'mesa-11', time:'10:30–12:10', room:'Auditorio Hunza 1', kind:'Mesa temática 11', title:'Pedagogías decoloniales, producción colectiva de conocimiento y garantía de derechos', duration:'1 h 40 min', talks:[
        {title:'Contra el silencio de la guerra: el duelo como práctica pedagógica y política',people:'Julián David Marín Quintero · ESAP'},
        {title:'Del derecho escrito al saber vivido: restablecimiento de derechos del Virrúa Emberá Chamí',people:'Oscar Zoni Delgado Delgado · ESAP'},
        {title:'Narrar para resistir: co-creación con mujeres buscadoras de Montes de María',people:'Yurleidis Arregoces Robles · ESAP'},
        {title:'Del diálogo de saberes a la producción colectiva de conocimiento',people:'Carolina García Sánchez · ESAP'} ]},
