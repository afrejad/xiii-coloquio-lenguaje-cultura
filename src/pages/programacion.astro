      { id:'mesa-14', time:'15:15–16:35', room:'Auditorio Hunza 1', kind:'Mesa temática 14', title:'Literaturas y estéticas desbordadas (3)', duration:'1 h 20 min', talks:[
        {title:'Libros en llamas: materialidad del texto y literatura en campo expandido',people:'Rafael Climent-Espino · Baylor University'},
        {title:'Lo diabólico y lo monstruoso en dos novelas sobre la plantación en Colombia',people:'Leonardo Gil Gómez · Universidad Distrital Francisco José de Caldas'},
        {title:'Blasphemia contra ordinem: el lenguaje disruptivo en el Black Metal',people:'Hernán Javier Pinzón Manrique · Universidad Santo Tomás'} ]},
      { id:'conferencia-6', time:'17:00–18:00', room:'Paraninfo', kind:'Conferencia 6', title:'La descolonización de la Estética y su importancia para la educación', people:'Dr. Dany Velásquez', duration:'1 h' },
      { id:'instalacion-mesa-15', time:'16:35–16:40', room:'Auditorio Hunza 1', kind:'Transición', title:'Instalación de nueva mesa', duration:'5 min' },
      { id:'mesa-15', time:'16:40–18:00', room:'Auditorio Hunza 1', kind:'Mesa temática 15', title:'Enseñanza de idiomas y autorregulación del aprendizaje en un mundo mediado por la virtualidad y la inteligencia artificial', duration:'1 h 20 min', talks:[
        {title:'Los retos de la educación bilingüe en la era de la globalización',people:'Marco Tulio Carivan Ponare · Investigador independiente'},
